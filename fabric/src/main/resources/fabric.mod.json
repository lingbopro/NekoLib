{
  "schemaVersion": 1,
  "id": "nekolib",
  "version": "${version}",
  "name": "NekoLib",
  "description": "Lightweight but powerful common library by lingbopro. UI, config, and more! (^・ω・^)",
  "authors": [
    "lingbopro"
  ],
  "contact": {
    "homepage": "https://github.com/lingbopro/NekoLib"
  },
  "license": "LGPL-3.0",
  "icon": "assets/nekolib/icon.png",
  "environment": "*",
  "entrypoints": {
